# Portfolio Management Dashboard Demo
#
# The demo needs NO configuration: `npm install && npm start` boots it with
# DEMO_MODE=1 (scripts/demoServer.js sets it for you), a fictional Rent Manager
# (services/demo) and an automatic admin sign-in. Nothing here is required.

# Port for the demo server (default 3001).
PORT=3001

# Optional: enables free-form answers in the Ask assistant and the contract
# analyzer. Without it, Ask answers a handful of canned questions from the demo
# data and says so.
ANTHROPIC_API_KEY=

# ── Not used by the demo (only for a live Rent Manager install) ──────────────
# Leave these blank. scripts/demoServer.js blanks them even if they are set, so
# the demo can never reach a real system. A live install would run server.js
# directly (without DEMO_MODE) and set:
#   RENTMANAGER_COMPANY=      your Rent Manager company subdomain
#   RENTMANAGER_USERNAME=     an API user
#   RENTMANAGER_PASSWORD=
#   RENTMANAGER_LOCATION_ID=  optional
#   DASHBOARD_PUBLIC_URL=     the site address used in emailed links
#   DASHBOARD_ACCESS_PIN=     one-time PIN to create the first admin account
#
# Refresh timers (milliseconds; blank = button-only), weekly schedule and
# renovation settings keep their defaults; see SETUP.md.
